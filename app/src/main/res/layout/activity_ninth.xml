<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4FAFC"
    tools:context=".Home.pertemuan_9.NinthActivity">

    <!-- Tahap 0.4: Toolbar dengan tombol back -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="#2D7FF9"
        app:title="Pertemuan 9"
        app:titleTextColor="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="40dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="25dp"
                android:layout_marginTop="20dp"
                android:hint="Nama Pelanggan"
                app:startIconDrawable="@drawable/ic_edit"
                app:endIconMode="clear_text"
                app:helperText="Masukkan nama pemesan (maks. 20 karakter)"
                app:counterEnabled="true"
                app:counterMaxLength="20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="25dp"
                android:layout_marginTop="12dp"
                android:text="Pesan Menu"
                android:textSize="15sp"
                android:backgroundTint="#2D7FF9"
                app:icon="@drawable/ic_login"
                app:cornerRadius="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textInputLayout" />

            <!-- Tahap 2: Chip & ChipGroup (Latihan Mandiri 7.1) -->
            <TextView
                android:id="@+id/tvChipTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:layout_marginTop="24dp"
                android:text="Filter Kategori (ChipGroup)"
                android:textColor="#183B56"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnLogin" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFilter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="25dp"
                android:layout_marginTop="8dp"
                app:singleSelection="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvChipTitle">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTerbaru"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Semua" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPenting"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kuliner Khas" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBelumDibaca"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Destinasi Wisata" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/tvPhoneTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:layout_marginTop="20dp"
                android:text="Input Background Rounded Drawable"
                android:textColor="#183B56"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/chipGroupFilter" />

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="25dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_rounded_container"
                android:hint="Nomor Telepon / WhatsApp"
                android:inputType="phone"
                android:textColor="#183B56"
                android:textColorHint="#90A4AE"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvPhoneTitle" />

            <!-- Tahap 4: GridLayout (Latihan Mandiri 7.2) -->
            <TextView
                android:id="@+id/tvGridTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:layout_marginTop="24dp"
                android:text="Menu Kopi &amp; Kuliner (GridLayout 3 Kolom)"
                android:textColor="#183B56"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etPhone" />

            <androidx.gridlayout.widget.GridLayout
                android:id="@+id/gridMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="8dp"
                android:padding="4dp"
                app:columnCount="3"
                app:useDefaultMargins="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvGridTitle">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenu1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Bolu Kemojo"
                    android:textSize="11sp"
                    android:backgroundTint="#2D7FF9"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenu2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Mie Sagu"
                    android:textSize="11sp"
                    android:backgroundTint="#2D7FF9"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenu3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Lopek Bugi"
                    android:textSize="11sp"
                    android:backgroundTint="#2D7FF9"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenu4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Asam Patin"
                    android:textSize="11sp"
                    android:backgroundTint="#2D7FF9"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenu5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Kopi Melayu"
                    android:textSize="11sp"
                    android:backgroundTint="#2D7FF9"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenu6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Es Laksamana"
                    android:textSize="11sp"
                    android:backgroundTint="#2D7FF9"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />
            </androidx.gridlayout.widget.GridLayout>

            <!-- TAHAP 5 & 6: KARTU TUTORIAL SCREEN & DOTSINDICATOR -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTutorialBanner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="25dp"
                android:layout_marginTop="28dp"
                app:cardBackgroundColor="#E8F1FF"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeColor="#2D7FF9"
                app:strokeWidth="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/gridMenu">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tahap 5 &amp; 6: Tutorial Screen &amp; DotsIndicator"
                        android:textColor="#1565C0"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:text="Layar Onboarding geser kiri-kanan dengan ViewPager2 dan indikator titik halaman dinamis (DotsIndicator)."
                        android:textColor="#37474F"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenTutorial"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:backgroundTint="#2D7FF9"
                        android:text="Buka Tutorial Screen (DotsIndicator) ➔"
                        android:textSize="13sp"
                        app:cornerRadius="10dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
